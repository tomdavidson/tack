{
  "name": "@tack/eslint-config",
  "version": "0.1.0",
  "description": "ESLint flat config for TypeScript with clean architecture boundaries, FP enforcement, oxlint, and oxlint dedup.",
  "keywords": [
    "eslint",
    "eslintconfig",
    "oxlint",
    "typescript",
    "functional",
    "clean-architecture",
    "boundaries"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./rules": "./src/rules.mjs",
    "./layers": "./src/layers.mjs",
    "./oxlintrc.jsonc": "./src/oxlintrc.jsonc",
    "./oxlintrc.json": "./src/oxlintrc.jsonc"
  },
  "main": "./src/index.mjs",
  "bin": {
    "install-oxlintrc": "./src/install-oxlintrc.mjs"
  },
  "files": ["src"],
  "dependencies": {
    "eslint-plugin-boundaries": "^6.0.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-prefer-arrow-functions": "^3.6.0",
    "eslint-plugin-sonarjs": "^3.0.0",
    "jsonc-parser": "^3.3.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  }
}
