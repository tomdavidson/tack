// .github/renovate.json5
//
// Renovate configuration for the tack repo itself.
// Tracks tack's own dependencies across root, packages/*, and configs/*:
//   - GitHub Actions (.github/workflows/*, .github/actions/*)
//   - npm & pnpm catalogs (package.json, pnpm-workspace.yaml, configs/*/pnpm-workspace.merge.yaml)
//   - Composer manifests (configs/drupal/**/composer*.json)
//   - proto tools (.prototools, configs/javascript/prototools.merge.toml, .moon/toolchains.yml)
//   - dprint plugins (configs/common/dprint-common.json)
//
// Consumer repos do NOT use this file. They receive configs/renovate/.github/renovate.json5
// via tack.sh, which only watches the .tack submodule for bumps.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "github>kachick/renovate-config-dprint"],

  baseBranchPatterns: ["main"],
  dependencyDashboard: true,
  osvVulnerabilityAlerts: true,
  minimumReleaseAge: "3 days",

  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security", "renovate"],
    minimumReleaseAge: "0 days",
  },

  labels: ["renovate"],
  prCreation: "immediate",
  prHourlyLimit: 4,
  prConcurrentLimit: 8,

  npm: {
    managerFilePatterns: [
      "/(^|/)pnpm-workspace\\.merge\\.ya?ml$/",
    ],
  },

  composer: {
    managerFilePatterns: [
      "/(^|/)composer\\.tera\\.json$/",
    ],
  },

  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      automerge: false,
    },
    {
      matchManagers: ["npm"],
      groupName: "npm & pnpm catalog dependencies",
      automerge: false,
    },
    {
      matchManagers: ["composer"],
      groupName: "Drupal composer templates",
      automerge: false,
    },
    {
      matchManagers: ["custom.regex"],
      groupName: "proto tools & dprint plugins",
      automerge: false,
    },
  ],

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/\\.github/actions/.+/action\\.ya?ml$/",
        "/\\.moon/toolchains\\.ya?ml$/",
      ],
      matchStrings: [
        "proto-version:\\s*\"(?<currentValue>[^\"]+)\"",
        "version:\\s*\"(?<currentValue>[^\"]+)\"",
      ],
      depNameTemplate: "moonrepo/proto",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/\\.github/actions/.+/action\\.ya?ml$/"],
      matchStrings: ["/cargo-bins/cargo-binstall/v(?<currentValue>[\\d.]+)/install-from-binstall-release"],
      depNameTemplate: "cargo-bins/cargo-binstall",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["moon\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "moonrepo/moon",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["(?:^|\\n)yq\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "mikefarah/yq",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["shfmt\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "mvdan/sh",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["shellcheck\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "koalaman/shellcheck",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["dprint\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "dprint/dprint",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["gitleaks\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "gitleaks/gitleaks",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["tera\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "chevdor/tera-cli",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/"],
      matchStrings: ["ruff\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "astral-sh/ruff",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/", "/(^|/)prototools\\.merge\\.toml$/"],
      matchStrings: ["node\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "node",
      datasourceTemplate: "node-version",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)\\.prototools$/", "/(^|/)prototools\\.merge\\.toml$/"],
      matchStrings: ["pnpm\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "pnpm",
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)dprint-[^/]+\\.json$/"],
      matchStrings: ["\"npm:(?<depName>@?[^@\"]+)@(?<currentValue>[^\"]+)\""],
      datasourceTemplate: "npm",
    },
  ],
}
