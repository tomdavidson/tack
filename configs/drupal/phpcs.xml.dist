<?xml version="1.0" encoding="UTF-8"?>
<!--
  Consumer-owned Drupal PHP_CodeSniffer config, seeded once by tack (overwrite: false).
  Shared rules live in .tack/configs/drupal/phpcs.xml (which extends
  .tack/configs/php/phpcs-base.xml + Drupal + DrupalPractice) and update
  automatically on submodule bumps. Add project-specific rule overrides below.
-->
<ruleset name="project-drupal">
  <description>Project Drupal PHP_CodeSniffer configuration extending tack's Drupal + PHP baseline.</description>

  <rule ref="./.tack/configs/drupal/phpcs.xml"/>
</ruleset>
