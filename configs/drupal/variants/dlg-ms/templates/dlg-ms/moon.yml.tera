# moon.yml — LocalGov DLG-MS app {{ name }}.
# Generated by moon generate dlg-ms. You own this file.
# Tasks are inherited from .moon/tasks/drupal-common.yml and
# .moon/tasks/drupal-app.yml via tags.

$schema: "https://moonrepo.dev/schemas/project.json"

id: "{{ name }}"
language: php
layer: application
tags: ["drupal", "drupal-app"]

# Site layout. Replaces the module-layout defaults from drupal-common.yml.
fileGroups:
  sourceDirs:
    - "web/modules/custom"
    - "web/themes/custom"
  sources:
    - "web/modules/custom/**/*"
    - "web/themes/custom/**/*"
  tests:
    - "tests/**/*"
    - "web/modules/custom/**/tests/**/*"
    - "web/themes/custom/**/tests/**/*"
  configs:
    - "/phpcs.xml.dist"
    - "/phpstan.neon.dist"
    - "/phpunit.xml.dist"
    - "composer.json"
    - "composer.lock"
    - "config/sync/**/*"

# Override or extend inherited tasks here, e.g.:
# tasks:
#   test-unit:
#     options:
#       envFile: ".env.test"
