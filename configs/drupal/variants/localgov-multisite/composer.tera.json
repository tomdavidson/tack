{
    "name": "{% if vars.project is defined and vars.project.name is defined %}{{ vars.project.name }}{% else %}hub{% endif %}",
    "description": "LocalGov Drupal Microsites hub on FrankenPHP, MariaDB and Fly.io.",
    "type": "project",
    "license": "proprietary",
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8",
            "exclude": [
                "drupal/domain_group",
                "drupal/group_permissions"
            ]
        },
        "drupal/domain_group": {
            "type": "vcs",
            "url": "https://git.drupalcode.org/project/domain_group.git"
        },
        "drupal/group_permissions": {
            "type": "vcs",
            "url": "https://git.drupalcode.org/project/group_permissions.git"
        }
    },
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7",
        "drupal/config_ignore_pattern": "^1.0",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/domain_path": "1.x-dev@dev as 1.5",
        "drupal/localgov_microsites": "^5.0",
        "drupal/localgov_microsites_group": "^4.6",
        "drupal/s3fs": "^3.11",
        "drush/drush": "^13.0"
    },
    "require-dev": {
        "drupal/core-dev": "^11.4",
        "drupal/localgov_microsites_demo": "^1.1@RC",
        "phpstan/phpstan-strict-rules": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.5"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": false
        },
        "platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "enable-patching": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "apps/hub/web/"
            },
            "file-mapping": {
                "[web-root]/sites/default/settings.php": false,
                "[web-root]/sites/default/default.settings.php": false
            }
        },
        "installer-paths": {
            "apps/hub/web/core": ["type:drupal-core"],
            "apps/hub/web/libraries/{$name}": ["type:drupal-library"],
            "apps/hub/web/modules/contrib/{$name}": ["type:drupal-module"],
            "apps/hub/web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "apps/hub/web/themes/contrib/{$name}": ["type:drupal-theme"],
            "apps/hub/drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "apps/hub/web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "apps/hub/web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "patches": {
            "drupal/localgov_microsites": {
                "Remove profile hook_install() so drush si --existing-config is allowed": "apps/hub/patches/localgov_microsites-remove-hook-install-for-existing-config.patch"
            }
        }
    }
}
