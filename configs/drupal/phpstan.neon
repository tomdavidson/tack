# Shared Drupal PHPStan baseline read through .tack via `includes`; never materialized.
# Extends the shared PHP baseline and sets Drupal-compatible defaults.
# phpstan-drupal, phpstan-strict-rules, and spaze/phpstan-disallowed-calls
# are wired in by phpstan/extension-installer.
includes:
  - ../php/phpstan.neon

parameters:
  level: 6
  excludePaths:
    - '*/node_modules/*'
    - '*/vendor/*'
    - '*/tests/*'
  ignoreErrors:
    # new static() is idiomatic Drupal (ContainerInjectionInterface::create).
    - '#^Unsafe usage of new static#'
