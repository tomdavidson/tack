# Consumer-owned Drupal PHPStan config, seeded once by tack (overwrite: false).
# Shared rules are read through .tack via `includes` (.tack/configs/drupal/phpstan.neon
# -> .tack/configs/php/phpstan.neon); bumping .tack updates those rules without
# touching this file. Put project-specific paths and overrides below.
includes:
  - .tack/configs/drupal/phpstan.neon

parameters:
  paths:
    - web/modules/custom
    - web/themes/custom
