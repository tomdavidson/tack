{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt --edition 2024",
        "exts": [
          "rs"
        ]
      },
      {
        "command": "shfmt -i {{indent_width}} -s -ci -sr",
        "exts": [
          "sh",
          "bash"
        ]
      },
      {
        "command": "sh -c 'phpcbf --standard=phpcs.xml.dist -q --stdin-path={{file_path}} - || [ $? -eq 1 ]'",
        "exts": [
          "php",
          "module",
          "inc",
          "install",
          "theme",
          "profile",
          "engine"
        ]
      }
    ]
  },
  "excludes": [
    "**/vendor",
    "**/web/core",
    "**/web/modules/contrib",
    "**/web/themes/contrib",
    "**/web/profiles/contrib",
    "**/web/libraries"
  ]
}
