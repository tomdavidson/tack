{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "exec": {
    "cwd": "${originConfigDir}",
    "commands": [
      {
        "command": "sh -c 'out=$(phpcbf --standard=phpcs.xml.dist -q --stdin-path=\"$1\" -); status=$?; [ $status -eq 0 ] || [ $status -eq 1 ] && printf \"%s\" \"$out\" || exit $status' _ {{file_path}}",
        "exts": [
          "php",
          "module",
          "inc",
          "install",
          "theme",
          "profile",
          "engine"
        ]
      }
    ]
  },
  "excludes": [
    "**/vendor",
    "**/web/core",
    "**/web/modules/contrib",
    "**/web/themes/contrib",
    "**/web/profiles/contrib",
    "**/web/libraries"
  ]
}
