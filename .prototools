# >= 0.55 required: dprint.json uses npm: plugin specifiers (dprint-plugin-nix).
dprint = "0.63.0"
lnko = "0.2"
yq = "4.53.3"
moon = "2.6.0"
tera = "0.5.0"
shellcheck = "0.11.0"
shfmt = "3.14.1"
ruff = "0.17.0"
node = "22.22.1"
pnpm = "10.32.1"

[plugins]
lnko = "https://tomdavidson.github.io/proto/lnko.toml"
dprint = "https://tomdavidson.github.io/proto/dprint.toml"
yq = "github://muuvmuuv/proto-plugins/yq_tool"
tera = "https://tomdavidson.github.io/proto/tera.toml"
shellcheck = "https://tomdavidson.github.io/proto/shellcheck.toml"
shfmt = "https://tomdavidson.github.io/proto/shfmt.toml"

[settings]
auto-install = true
# proto 0.63 auto-clean deletes the pinned, freshly installed version under
# parallel invocations (observed: yq 4.53.3 removed mid `bats --jobs`, stale
# 4.53.2 kept). Run `proto clean` by hand until that is fixed upstream.
auto-clean = false
detect-strategy = "prefer-prototools"
