#!/usr/bin/env bash
set -eo pipefail

for (( i=0; i <= $#; i++ )); do
  declare -x "ARG$i"="${!i}"
done

# Automatically generated by moon. DO NOT MODIFY!
# https://moonrepo.dev/docs/guides/vcs-hooks


set -euo pipefail

branch="$(git branch --show-current)"

# ---- Trunk detection ----
detect_trunk() {
  local t

  # 1. Local symbolic ref (fastest; no network)
  t="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
  [[ -n "$t" ]] && { echo "$t"; return 0; }

  # 2. Self-heal: ask origin once, then retry the symbolic ref
  if git remote set-head origin --auto >/dev/null 2>&1; then
    t="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
    [[ -n "$t" ]] && { echo "$t"; return 0; }
  fi

  # 3. git init default (respects user config)
  t="$(git config --get init.defaultBranch 2>/dev/null || true)"
  [[ -n "$t" ]] && { echo "$t"; return 0; }

  # 4. Common remote-tracking branches that actually exist
  for c in main master trunk develop; do
    if git show-ref --verify --quiet "refs/remotes/origin/$c"; then
      echo "$c"; return 0
    fi
  done

  # 5. Last resort
  echo main
}

trunk="$(detect_trunk)"

# ---- Initial-push / no-upstream bail-out ----
has_upstream=0
git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1 && has_upstream=1

has_remote_refs=0
git for-each-ref --count=1 refs/remotes/origin/ | grep -q . && has_remote_refs=1

if (( ! has_upstream )) || (( ! has_remote_refs )); then
  echo "Initial push or no upstream. Skipping fmt/lint-fix."
  exit 0
fi

# ---- Affected-file query + run refs ----
if [[ "$branch" == "$trunk" ]]; then
  mapfile -t affected_files < <(moon query changed-files --default-branch | jq -r '.files[]')
  run_refs=(--base "HEAD~1" --head HEAD)

elif git show-ref --verify --quiet "refs/remotes/origin/$trunk"; then
  mapfile -t affected_files < <(moon query changed-files --base "origin/$trunk" --head HEAD | jq -r '.files[]')
  run_refs=(--base "origin/$trunk" --head HEAD)

else
  mapfile -t affected_files < <(moon query changed-files --local | jq -r '.files[]')
  run_refs=()
fi

# ---- fmt + lint-fix ----
if ! moon run :fmt :lint-fix --affected "${run_refs[@]}"; then
  echo "fmt/lint-fix failed. Aborting git push."
  exit 1
fi

# ---- Stage just the affected files ----
if ((${#affected_files[@]} > 0)); then
  existing=()
  for f in "${affected_files[@]}"; do [[ -e "$f" ]] && existing+=("$f"); done
  ((${#existing[@]} > 0)) && printf '%s\0' "${existing[@]}" | xargs -0 -r git add --
fi

git diff --cached --quiet || git commit -m "chore: auto-format and lint-fix before push"

.moon/scripts/auto-squash.sh check || { echo "Auto-squash failed. Aborting git push."; exit 1; }


