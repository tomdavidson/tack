#!/usr/bin/env bash
set -eo pipefail

for (( i=0; i <= $#; i++ )); do
  declare -x "ARG$i"="${!i}"
done

# Automatically generated by moon. DO NOT MODIFY!
# https://moonrepo.dev/docs/guides/vcs-hooks

branch="$(git branch --show-current)"; moon_cmd=(moon run :lint :fmt-check :test);
git diff --quiet && git diff --cached --quiet || {
  echo "Dirty working tree. Commit all changes before pushing.";
  exit 1;
};
if [[ "$branch" != "main" ]]; then
  moon_cmd+=(--affected --base origin/main --head HEAD);
else
  if ! .moon/scripts/auto-squash.sh; then
    echo "Auto-squash aborted. Aborting git push.";
    exit 1;
  fi
fi;
"${moon_cmd[@]}"


