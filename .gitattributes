# ---- Lockfiles: text but exclude from diffs by default ----
package-lock.json    text eol=lf -diff
pnpm-lock.yaml       text eol=lf -diff
yarn.lock            text eol=lf -diff
Cargo.lock           text eol=lf -diff
poetry.lock          text eol=lf -diff
uv.lock              text eol=lf -diff
go.sum               text eol=lf -diff
Gemfile.lock         text eol=lf -diff
composer.lock        text eol=lf -diff

# ---- Linguist: language hints ----
*.ipynb              linguist-language=Jupyter\ Notebook
*.mdx                linguist-language=MDX
*.tera.json          linguist-language=JSON
*.tera.yml           linguist-language=YAML
*.tera.yaml          linguist-language=YAML
*.tera.toml          linguist-language=TOML

# ---- Linguist: collapse generated/vendored from PR diffs and stats ----
*.min.js             linguist-generated=true
*.min.css            linguist-generated=true
*.map                linguist-generated=true
dist/**              linguist-generated=true
build/**             linguist-generated=true
out/**               linguist-generated=true
target/**            linguist-generated=true
coverage/**          linguist-generated=true
**/__snapshots__/**  linguist-generated=true
**/*.snap            linguist-generated=true
**/generated/**      linguist-generated=true
**/*.pb.go           linguist-generated=true
**/*.pb.ts           linguist-generated=true
**/*_pb2.py          linguist-generated=true

vendor/**            linguist-vendored=true
third_party/**       linguist-vendored=true
third-party/**       linguist-vendored=true

docs/**              linguist-documentation=true

# ---- Export-ignore: omit from `git archive` tarballs ----
.gitattributes       export-ignore
.gitignore           export-ignore
.github/             export-ignore
.vscode/             export-ignore
tests/               export-ignore
test/                export-ignore
**/__tests__/**      export-ignore
**/*.test.*          export-ignore
**/*.spec.*          export-ignore
